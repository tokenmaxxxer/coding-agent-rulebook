{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/directive.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/state.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hunt-state.sh reset" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/coding-progress-gate.sh" }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hunt-guard.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hunt-state.sh release" }
        ]
      }
    ]
  }
}
